# Configuración del Servidor y Entorno
PORT=3000
NODE_ENV=development

# Credenciales de Spotify Developer API
# Obtén tus credenciales en https://developer.spotify.com/dashboard
# Asegúrate de agregar esta Redirect URI en los settings de tu Spotify App:
# http://localhost:3000/api/spotify/callback
# (O para Render: https://tu-nombre-de-app.onrender.com/api/spotify/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
