# ============================================================================
# Configuración del Servidor - Supabase Chat Conversor YouTube a MP3
# Versión: 1.9.0
# ============================================================================
# Copia este archivo como ".env" y completa las variables que necesites.
# NUNCA subas tu .env real al repositorio (ya está en .gitignore).
# ============================================================================

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Proxy de YouTube (Red Restringida / Corporativa) ─────────────────────────
# Si YouTube está bloqueado en tu red, configura una de estas variables:
#
# Formato HTTP/HTTPS:
#   YOUTUBE_PROXY=http://usuario:password@proxy.empresa.com:8080
#   YOUTUBE_PROXY=http://192.168.1.100:3128
#
# Formato SOCKS5 (requiere: npm install socks-proxy-agent):
#   YOUTUBE_PROXY=socks5://usuario:password@proxy.empresa.com:1080
#
# Nota: Esta variable se propaga automáticamente a yt-dlp con --proxy
# para que las descargas también pasen por el proxy.
YOUTUBE_PROXY=

# ── Cookies de YouTube (Anti-Bot / Anti-429 en Render/VPS) ───────────────────
# Si YouTube muestra "Sign in to confirm you're not a bot" (Error 429),
# exporta tus cookies con la extensión del navegador "Get cookies.txt LOCALLY"
# y pon el contenido aquí (como texto plano en formato Netscape/Mozilla).
#
# Opción A: Coloca el archivo cookies.txt directamente en la raíz del proyecto.
#
# Opción B: Copia el contenido del cookies.txt en esta variable:
YOUTUBE_COOKIES=

# Opción C: Si el texto tiene saltos de línea problemáticos, usa base64:
#   cat cookies.txt | base64 -w 0
YOUTUBE_COOKIES_BASE64=

# ── Spotify API (Opcional - no requerido para la función principal) ───────────
# Obtén tus credenciales en https://developer.spotify.com/dashboard
# Agrega esta Redirect URI en los settings de tu Spotify App:
#   http://localhost:3000/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
